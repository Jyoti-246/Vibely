# --- MongoDB Atlas connection string (REQUIRED) ---
# Atlas: Cluster > Connect > Drivers. Keep the db name (vibely) in the path.
# mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/vibely?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT auth tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Port the API server listens on
PORT=4000

# Public base URL of this backend (used to build uploaded-image URLs)
PUBLIC_URL=http://localhost:4000

# Password assigned to every migrated user (Supabase passwords cannot be exported).
# Log in with any migrated email + this password. Matches the app's original test user.
MIGRATION_DEFAULT_PASSWORD=12345
